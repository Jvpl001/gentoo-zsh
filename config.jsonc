            "key": "{#@208}{#@166}{#@208}{#@220}│ DRIVE-STATUS",
            "text": "s=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -1); c=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1); if [ \"$s\" = \"Discharging\" ]; then t=$((c * 3)); printf \"EMERGENCY FALLBACK - %d:%02d\\n\" $((t/60)) $((t%60)); else echo \"S²\"; fi"
        },
